OPENROUTER_API_KEY=
MODEL_NAME=
# Limits on a run of the queue, with their defaults. The time on one claim is
# agent_run_timeout_seconds in data/company.json.
CLAIM_STEP_LIMIT=30
RUN_TOKEN_LIMIT=1000000
PROVIDER_FAILURES_TO_PAUSE=3
MODEL_TIMEOUT_SECONDS=60
# Voice is off unless VOICE_ENABLED=1. VOICE_PROVIDER is browser, or stub for tests.
VOICE_ENABLED=0
VOICE_PROVIDER=browser
# Sign-in. Without DEMO_PASSWORD each demo user gets a random password, printed
# once by the backend when it first creates the users. COOKIE_SECURE=0 only for
# plain http other than localhost. API_DOCS=1 serves /docs and /openapi.json.
DEMO_PASSWORD=
COOKIE_SECURE=1
SESSION_IDLE_MINUTES=30
SESSION_HOURS=12
API_DOCS=0
# Supabase: with DATABASE_URL (the session pooler's connection string) the
# backend and the claim agent's checkpointer use PostgreSQL in the undercover
# schema; without it, SQLite. Tests and e2e never use it.
DATABASE_URL=
# Langfuse: with all three, each claim's work is traced as one session.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# The agent's service. npm run dev makes a key for the session if this is empty;
# set one to run `uv run -m agent` on its own beside the backend.
UNDERCOVER_AGENT=http://127.0.0.1:8002
AGENT_SERVICE_KEY=
