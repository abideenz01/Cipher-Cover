{
  "name": "cipher-cover",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "lefthook install && playwright install chromium",
    "dev": "concurrently -k -n backend,dashboard npm:dev:backend npm:dev:dashboard",
    "dev:backend": "uv run -m uvicorn backend.main:app --reload --reload-dir backend",
    "dev:dashboard": "vite dashboard",
    "format": "uv run ruff format && prettier --write -u dashboard e2e *.config.*",
    "check": "npm run check:python && npm run check:ts && npm run e2e",
    "check:python": "uv run ruff format --check && uv run ruff check && pyright && uv run pytest -q",
    "check:ts": "prettier --check -u dashboard e2e *.config.* && eslint dashboard e2e *.config.* && tsc && vitest run --root dashboard --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "pyright": "^1.1.414",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "lefthook": false,
    "fsevents": false
  }
}
